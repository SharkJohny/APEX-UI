# Copy to .env.local and restart `npm run dev`. EVERYTHING here is optional.
# Without any key Apex runs on your subscriptions through the logged-in
# `claude` (Claude Code) and `codex` (ChatGPT) CLIs, speaks with the browser voice,
# and keeps its data in data/apex.db.

# ── Google (Gmail, Calendar, Drive) ─ see README "Google setup"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Social publishing (only after you approve a post in the Deck)
# Facebook Page + Instagram Business (Meta Graph API)
# FB_PAGE_ID=
# FB_PAGE_TOKEN=
# IG_USER_ID=
# LinkedIn (w_member_social)
# LINKEDIN_TOKEN=
# LINKEDIN_AUTHOR_URN=urn:li:person:xxxx
# LINKEDIN_VERSION=202409

# ── Natural voice (paid; ElevenLabs wins if both are set)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2
# OPENAI_API_KEY=sk-...
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# ── Extra chat-only providers (paid APIs, no tools)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Tuning
# APEX_CLAUDE_MODEL=sonnet        # model for the claude CLI (default: its own default)
# APEX_CODEX_MODEL=
# APEX_LLM_TIMEOUT_MS=600000      # per agent call
# APEX_DATA_DIR=./data
